# Only what is specific to this directory. Build output (dist/, dist-pages/),
# node_modules/, *.tsbuildinfo and the router plugin's .tanstack/ scratch dir
# are all covered by the repository root .gitignore.

# Vite writes these for `vite build --mode <name>` overrides; they are local.
.env.local
.env.*.local

# Editor and OS noise the root file does not cover.
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
