# Settings for the static GitHub Pages build (`vite build --mode pages`).
#
# Replay mode ships recorded fixtures instead of talking to a Go server, because
# Pages serves static files only. Regenerate the fixtures with `npm run record`.
VITE_REPLAY=1

# Project pages live under the repo name. Change this if you move to a user page
# or a custom domain, where the site is served from the root.
VITE_BASE=/Go-Ledger/
