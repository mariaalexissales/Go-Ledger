# Go uses tabs, everything else uses two spaces. Without this the two halves of
# the repo fight over whatever the editor happens to default to.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

# Trailing whitespace is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
