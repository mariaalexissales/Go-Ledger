# Copy to .env for local development. The container reads real environment
# variables instead (see docker-compose.yml), and a missing .env is not fatal.

# Required.
DATABASE_URL=postgres://postgres:password@localhost:5432/go_ledger_db?sslmode=disable

# Optional. The defaults below are what the server uses when these are unset.
PORT=8080

# Comma-separated. Needed only in dev, where Vite serves the console from
# another origin. Set to empty when the Go binary serves the console itself.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How the security guard decides who a request came from.
#   xff-trust-all  reads X-Forwarded-For verbatim (spoofable, and what the
#                  xff-spoof demo exploits)
#   remote-addr    ignores forwarding headers and uses the socket peer
CLIENT_IP_MODE=xff-trust-all

# Rate limiter. Loose enough that ordinary browsing never trips it; the demo
# scenarios scale their request counts to whatever is configured here.
RATE_LIMIT=30
RATE_WINDOW=10s
RATE_BLOCK_PERIOD=30s

# The /ops observability plane and the demo runner have NO authentication.
# Both must be false anywhere that is not a local demo.
OPS_ENABLED=true
DEMOS_ENABLED=true

# Fill an empty database on boot. Idempotent, skipped when accounts exist.
SEED_ON_START=false

# Makes the generated fake ledger reproducible. The "Record demo data" workflow
# sets this so re-recording the public demo yields the same 50 accounts and the
# fixture diff shows only what actually changed. 0 means crypto-random.
FAKE_SEED=0

# Serve a built console from disk instead of the embedded bundle.
# SPA_DIR=internal/spa/dist
